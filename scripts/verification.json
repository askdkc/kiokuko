        "darwin"
      ],
      "exclusionReason": "This existing CI check targets linux, darwin; other OSes are outside its declared scope."
    },
    {
      "id": "sqlite-vec",
      "argv": [
        "npm",
        "run",
        "test:sqlite-vec"
