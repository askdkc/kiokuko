{
  "schema": "verification-contract-v1",
  "package": "kiokuko",
  "profiles": [
    "full",
    "main",
    "semantic",
    "record"
  ],
  "environment": {
    "KIOKUKO_REQUIRE_SQLITE_VEC_SMOKE": "1"
  },
  "checks": [
    {
      "id": "verification-contract",
      "argv": [
        "node",
        "--test",
        "scripts/verification-contract.test.mjs"
      ],
      "profiles": [
        "main",
        "semantic",
        "record"
      ],
      "result": "node",
      "requires": [],
      "expected": "complete official lifecycle; at least one passing leaf; no failures, cancellation, todo or undeclared skips",
      "dependsOn": []
    },
    {
      "id": "typecheck",
      "argv": [
        "npm",
        "run",
        "typecheck"
      ],
      "profiles": [
        "main"
      ],
      "result": "command",
      "requires": [],
      "expected": "exit 0",
      "dependsOn": []
    },
    {
      "id": "build",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "profiles": [
        "main",
        "semantic",
        "record"
      ],
      "result": "command",
      "requires": [],
      "expected": "exit 0",
      "dependsOn": []
    },
    {
      "id": "suite",
      "argv": [
        "node",
        "scripts/run-tests.mjs",
        "tests"
      ],
      "profiles": [
        "main"
      ],
      "result": "node",
      "requires": [],
      "expected": "complete official lifecycle; at least one passing leaf; no failures, cancellation, todo or undeclared skips",
      "dependsOn": [
        "build"
      ],
      "testCapabilities": [
        "tunnel-client"
      ]
    },
    {
      "id": "retrieval",
      "argv": [
        "npm",
        "run",
        "test:evaluation"
      ],
      "profiles": [
        "main"
      ],
      "result": "script",
      "requires": [],
      "expected": "existing independent assertions finish, emit their result and exit 0",
      "dependsOn": [
        "build"
      ]
    },
    {
      "id": "sampledb",
      "argv": [
        "npm",
        "run",
        "test:sampledb"
      ],
      "profiles": [
        "main"
      ],
      "result": "script",
      "requires": [],
      "expected": "existing independent assertions finish, emit their result and exit 0",
      "dependsOn": [
        "build"
      ]
    },
    {
      "id": "pack-contents",
      "argv": [
        "npm",
        "run",
        "pack:check"
      ],
      "profiles": [
        "main"
      ],
      "result": "command",
      "requires": [],
      "expected": "exit 0",
      "dependsOn": [
        "build"
      ]
    },
    {
      "id": "installed",
      "argv": [
        "node",
        "tests/ci/global-install-smoke.mjs"
      ],
      "profiles": [
        "main"
      ],
      "result": "script",
      "requires": [],
      "expected": "existing independent assertions finish, emit their result and exit 0",
      "dependsOn": [
        "build"
      ],
      "packed": true
    },
    {
      "id": "interaction-fault",
      "argv": [
        "node",
        "tests/ci/interaction-fault-smoke.mjs"
      ],
      "profiles": [
        "main"
      ],
      "result": "script",
      "requires": [],
      "expected": "existing independent assertions finish, emit their result and exit 0",
      "dependsOn": [
        "build"
      ]
    },
    {
      "id": "clean-repository",
      "argv": [
        "docker",
        "run",
        "--rm",
        "--network",
        "none",
        "-v",
        "{root}:/workspace:ro",
        "-w",
        "/workspace",
        "node:24-bookworm",
        "node",
        "tests/ci/repository-root-smoke.mjs"
      ],
      "profiles": [
        "main"
      ],
      "result": "script",
      "requires": [
        "docker"
      ],
      "expected": "existing independent assertions finish, emit their result and exit 0",
      "dependsOn": [
        "build"
      ],
      "platforms": [
        "linux"
      ],
      "exclusionReason": "This existing CI check targets linux; other OSes are outside its declared scope."
    },
    {
      "id": "agenticreplay",
      "argv": [
        "npm",
        "run",
        "test:agenticreplay"
      ],
      "profiles": [
        "record"
      ],
      "result": "script",
      "requires": [
        "agenticreplay-pinned"
