    {
      "id": "embedding",
      "argv": [
        "node",
        "scripts/run-local-embedding-smoke.mjs",
        "--offline"
      ],
      "profiles": [
        "main",
        "semantic"
      ],
      "result": "script",
      "requires": [],
      "expected": "existing independent assertions finish, emit their result and exit 0",
      "dependsOn": [
        "build"
      ]
    }
  ],
  "testExclusions": [],
  "capabilities": {
    "opencode": {
      "environment": "OPENCODE_BIN",
      "binary": "opencode"
    },
    "agenticreplay": {
      "environment": "KIOKUKO_TEST_AGENTICREPLAY",
      "binary": "agenticreplay"
    },
    "tunnel-client": {
      "environment": "KIOKUKO_TUNNEL_CLIENT",
      "binary": "tunnel-client"
    },
    "ripwire": {
      "environment": "KIOKUKO_TEST_RIPWIRE",
      "binary": "ripwire"
    },
    "agenticreplay-pinned": {
      "environment": "KIOKUKO_TEST_AGENTICREPLAY",
      "binary": "agenticreplay",
      "version": "0.1.2"
    }
  },
  "coveredChecks": [
    {
      "id": "memory-index",
      "coveredBy": "suite",
      "files": [
        "tests/integration/memory-index.test.ts"
      ],
      "reason": "The same tests and environment are already executed by the recursive suite."
    }
  ]
