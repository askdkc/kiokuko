# Kiokuko integration tests can start loopback HTTP servers. These fixed test
# entry points must run outside Codex's sandbox from the first attempt.

prefix_rule(
    pattern = ["node", "scripts/run-tests.mjs"],
    decision = "allow",
    justification = "Kiokuko's focused test runner can execute integration tests that start loopback HTTP listeners.",
    match = ["node scripts/run-tests.mjs"],
)

prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Kiokuko's full test suite starts loopback HTTP listeners that the Codex sandbox blocks.",
    match = ["npm test"],
    not_match = ["npm run test:unit", "npm run test:integration"],
)

prefix_rule(
    pattern = ["npm", "run", "prepublishOnly"],
    decision = "allow",
    justification = "Kiokuko's release verification includes the full listener-dependent test suite.",
    match = ["npm run prepublishOnly"],
    not_match = ["npm run build", "npm run pack:check"],
)
